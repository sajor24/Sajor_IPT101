<Window x:Class="SajorIPT101.SajorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SajorIPT101.SajorWPF"
        xmlns:views="clr-namespace:SajorIPT101.SajorWPF.Views"
        xmlns:viewmodels="clr-namespace:SajorIPT101.SajorWPF.ViewModels"
        mc:Ignorable="d"
        Title="Employee Management System" Height="600" Width="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <DataTemplate DataType="{x:Type viewmodels:AddEmployeeViewModel}">
            <views:AddEmployeeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:EditEmployeeViewModel}">
            <views:EditEmployeeView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:EmployeesView DataContext="{Binding EmployeesViewModel}" />

        <Grid Grid.Row="0" Background="#80000000" Visibility="{Binding IsModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" Width="500" Height="auto" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20" CornerRadius="10">
                <ContentControl Content="{Binding CurrentModalViewModel}" />
            </Border>
        </Grid>
    </Grid>
</Window>
