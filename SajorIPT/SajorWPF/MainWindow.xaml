<Window x:Class="SajorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SajorWPF"
        xmlns:converters="clr-namespace:SajorWPF.Converters"
        mc:Ignorable="d"
        Title="Employee Manager" Height="500" Width="900">
    <Window.Resources>
        <converters:PlaceholderConverter x:Key="PlaceholderConverter"/>
    </Window.Resources>
    <Grid Background="#FFD75F5F" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Input Form -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Employee Form" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="White"/>
            
            <Label Content="First Name:" Foreground="White"/>
            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>

            <Label Content="Last Name:" Foreground="White"/>
            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>

            <Label Content="Age:" Foreground="White"/>
            <TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,10"/>

            <Label Content="Position:" Foreground="White"/>
            <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="Add" Command="{Binding AddCommand}" Width="60" Height="35" Margin="5"/>
                <Button Content="Update" Command="{Binding UpdateCommand}" Width="60" Height="35" Margin="5"/>
                <Button Content="Delete" Command="{Binding DeleteCommand}" Width="60" Height="35" Margin="5"/>
                <Button Content="Clear" Command="{Binding ClearCommand}" Width="60" Height="35" Margin="5"/>
            </StackPanel>
        </StackPanel>

        <!-- Employee List -->
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Employee List" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="White" HorizontalAlignment="Center"/>
            
            <DataGrid ItemsSource="{Binding Employees}" 
                      SelectedItem="{Binding SelectedEmployee}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Height="380"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                    <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*"/>
                    <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*"/>
                    <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="60"/>
                    <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
