<UserControl x:Class="SajorIPT101.SajorWPF.Components.EmployeeDetailsForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SajorIPT101.SajorWPF.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <Grid Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="First Name:" Margin="0 0 10 10" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EmployeeDetails.FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Last Name:" Margin="0 0 10 10" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EmployeeDetails.LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Age:" Margin="0 0 10 10" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EmployeeDetails.Age, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Position:" Margin="0 0 10 10" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EmployeeDetails.Position, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Submit" Command="{Binding SubmitCommand}" Margin="0 0 10 0" Padding="10 5" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10 5" />
        </StackPanel>
    </StackPanel>
</UserControl>
